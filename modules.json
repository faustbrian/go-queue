        "responsibility": "Provide backend-neutral bounded worker coordination plus explicit in-memory, Redis, Valkey, NATS, and NSQ queue implementations with observable delivery, settlement, failure, and lifecycle semantics.",
        "non_goals": [
          "Provide exactly-once processing, application idempotency, scheduling, workflow, transactional outbox, broker topology management, or a universal messaging framework.",
          "Hide backend durability, retry, settlement, cancellation, resource ownership, or unknown-outcome differences behind one transport abstraction.",
          "Own application handlers, credentials, telemetry backends, service runtime, or external control-plane lifecycle."
        ],
        "public_package_identifier": "queue",
        "primary_entry_packages": [
          "github.com/faustbrian/go-queue/v2"
        ],
        "package_selection": {
          "github.com/faustbrian/go-queue/v2": "Use to coordinate bounded worker concurrency, handler retry, cancellation, observation, and settlement over an explicitly selected backend.",
          "github.com/faustbrian/go-queue/v2/management": "Use for backend-neutral status, record inspection, lifecycle control, desired-state reconciliation, and capability negotiation contracts.",
          "github.com/faustbrian/go-queue/v2/managementhttp": "Use to expose or consume bounded authenticated queue-management contracts over HTTP.",
          "github.com/faustbrian/go-queue/v2/nats": "Use for transient NATS Core worker delivery.",
          "github.com/faustbrian/go-queue/v2/nsq": "Use for NSQ delivery with explicit requeue and dead-letter behavior.",
          "github.com/faustbrian/go-queue/v2/redisdb": "Use for low-latency, non-durable Redis Pub/Sub delivery.",
          "github.com/faustbrian/go-queue/v2/adapters/redisstream": "Use for durable Redis Streams consumer-group delivery, reclaim, settlement, and dead-letter handling.",
          "github.com/faustbrian/go-queue/v2/valkeystream": "Use for native durable Valkey Streams publishing, consumption, reclaim, and dead-letter handling."
        },
